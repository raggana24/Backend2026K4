
#!/usr/bin/env python3
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse
import json
import os
import secrets

BASE = os.path.expanduser("~/phish")
DEMO_OTP = "123456"


def read_file(path):
    with open(path, "rb") as file:
        return file.read()


class H(BaseHTTPRequestHandler):

    def send_body(self, status, body, content_type):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def send_json(self, status, data):
        body = json.dumps(data).encode("utf-8")
        self.send_body(
            status, body, "application/json; charset=utf-8"
        )

    def do_GET(self):
        path = urlparse(self.path).path

        routes = {
            "/": ("index.html", "text/html; charset=utf-8"),
            "/verify": ("verify.html", "text/html; charset=utf-8"),
            "/static/styles.css": (
                "static/styles.css", "text/css; charset=utf-8"
            ),
            "/static/veltra.js": (
                "static/veltra.js",
                "application/javascript; charset=utf-8"
            ),
        }

        if path not in routes:
            self.send_body(404, b"No encontrado", "text/plain")
            return

        filename, content_type = routes[path]

        try:
            body = read_file(os.path.join(BASE, filename))
            self.send_body(200, body, content_type)
        except OSError:
            self.send_body(
                500, b"No se pudo leer el archivo",
                "text/plain; charset=utf-8"
            )

    def do_POST(self):
        path = urlparse(self.path).path

        if path != "/api/verify-demo":
            self.send_json(404, {"message": "Ruta no encontrada"})
            return

        try:
            length = int(self.headers.get("Content-Length", "0"))

            if length < 1 or length > 4096:
                self.send_json(400, {"message": "Solicitud invalida"})
                return

            data = json.loads(self.rfile.read(length))
        except (ValueError, json.JSONDecodeError):
            self.send_json(400, {"message": "JSON invalido"})
            return

        otp = data.get("otp", "")

        if not isinstance(otp, str) or len(otp) != 6 or not otp.isdigit():
            self.send_json(
                400, {"message": "Ingresa seis digitos numericos"}
            )
            return

        if secrets.compare_digest(otp, DEMO_OTP):
            self.send_json(
                200, {"ok": True, "message": "Verificacion de prueba correcta"}
            )
        else:
            self.send_json(
                200, {"ok": False, "message": "Codigo de prueba incorrecto"}
            )

    def log_message(self, format_string, *args):
        # Evita registrar cuerpos o datos de autenticacion.
        print(f"{self.command} {self.path} - {args[1] if len(args) > 1 else ''}")


if __name__ == "__main__":
    print("Laboratorio local disponible en http://127.0.0.1:8000")
    HTTPServer(("127.0.0.1", 8000), H).serve_forever()
